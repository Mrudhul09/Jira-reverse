{
  "name": "itsm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "migrate": "node scripts/migrate.mjs",
    "dev": "npm run tokens && next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "reset-db": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
