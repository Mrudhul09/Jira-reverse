# Copy to .env.local and fill in. Never commit .env.local.

# Where people reach the app; used in email links.
APP_URL=

# First start of a real install (no demo data): set SEED_DEMO=0 and the first admin.
SEED_DEMO=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Email through Resend (https://resend.com), from a domain IT has verified there.
# Without these, emails are held in Settings > Email and jobs instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Shared secret monitoring tools send as the x-alert-token header to POST /api/alerts.
ALERT_TOKEN=
# Email intake: your mail provider posts incoming messages to /api/inbound-email with this in the x-inbound-token header
INBOUND_TOKEN=

# Optional
DATABASE_PATH=
BACKUP_DIR=
BACKUP_KEEP=
# 1 only when testing production over plain http on your own machine.
ALLOW_HTTP=
# 1 shows the demo logins on the sign-in page in production.
SHOW_DEMO_ACCOUNTS=
# off stops the background worker (for one-off scripts).
JOBS=
